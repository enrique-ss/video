# Configurações do TikTok Cinema (Estilo Gartic Phone)
# Para rodar 100% offline localmente usando o SQLite local, mantenha as chaves abaixo em branco.

APP_MODE=offline
PORT=3002

# Configurações do Supabase (Opcional - Necessário apenas para nuvem/online)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Chaves da API do TikTok (Opcional - Para futuras integrações)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
REDIRECT_URI=http://localhost:3002/api/tiktok/callback

# Chave de busca de GIFs do GIPHY (Opcional - Adicione sua chave Beta/Produção grátis)
GIPHY_API_KEY=
